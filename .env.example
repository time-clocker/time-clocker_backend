# FastAPI
APP_NAME=WorkTime API
APP_ENV=local
APP_DEBUG=true

# CORS
CORS_ALLOW_ORIGINS=https://tu-frontend.netlify.app, http://localhost:5173

# Database (asyncpg)
DATABASE_URL=postgresql+asyncpg://worktime_user:1234@localhost:5432/worktime

# Firebase Admin (pega el JSON del Service Account en una sola línea)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
FIREBASE_PROJECT_ID=tu-project-id

# Reports
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_HOURLY_RATE=15000
